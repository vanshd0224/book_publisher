# Launch-Scope Environment Variables for Book Publisher Backend
PORT=8080
NODE_ENV=development

# Database Connection (PostgreSQL Cloud SQL / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/book_publisher?schema=public"

# Authentication Security Secrets
JWT_SECRET="super-secret-jwt-access-key-book-publisher-2026"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-book-publisher-2026"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="xxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxx"

# GCP Storage Configuration
GCP_PROJECT_ID="book-publisher-prod"
GCS_BUCKET_NAME="book-publisher-invoices-pos"

# SMS Gateway (MSG91 / Twilio) - Login OTP & Order Confirmation ONLY
SMS_PROVIDER_API_KEY="msg91_api_key_xxxxxx"

# SendGrid Email - Invoice Delivery ONLY (No email auth / order confirmation)
SENDGRID_API_KEY="SG.xxxxxx"
SENDGRID_FROM_EMAIL="invoices@bookpublisher.com"

# Observability & Monitoring
SENTRY_DSN="https://xxxxxx@sentry.io/xxxxxx"
