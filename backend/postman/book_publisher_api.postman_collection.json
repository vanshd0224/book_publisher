    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart with Dynamic Bulk Discount",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/cart", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart"] }
          }
        },
        {
          "name": "Add 10 Sets to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/cart/add", "host": ["{{baseUrl}}"], "path": ["api", "v1", "cart", "add"] }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Institutional Order (PENDING_APPROVAL)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{productId}}\", \"quantity\": 15 }\n  ],\n  \"shippingAddress\": \"Central Library, AIIMS New Delhi\",\n  \"paymentMethod\": \"PO\",\n  \"tdsExpected\": 350.00\n}"
