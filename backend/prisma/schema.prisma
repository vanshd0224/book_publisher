datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  INDIVIDUAL
  INSTITUTION
  ADMIN
}

enum CollegeType {
  GOVT
  PRIVATE
  DEEMED
}

enum OrderType {
  INDIVIDUAL
  INSTITUTIONAL
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PENDING_APPROVAL
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  BANK_TRANSFER
  PO
}

enum InvoiceType {
  PROFORMA
  FINAL
}

enum LeadSource {
  CHATBOT
  FORM
  MANUAL
}

enum LeadStatus {
  CONTACTED
  INTERESTED
  QUOTE_SENT
  PO_RECEIVED
  PAID
  DISPATCHED
}

enum POUploadStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  phone              String              @unique
  passwordHash       String              @map("password_hash")
  role               Role                @default(INDIVIDUAL)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  institutionProfile InstitutionProfile?
  orders             Order[]
  cartItems          CartItem[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model InstitutionProfile {
  id          String      @id @default(uuid())
  userId      String      @unique @map("user_id")
  collegeName String      @map("college_name")
  gstin       String?
  address     String
  designation String
  collegeType CollegeType @default(GOVT) @map("college_type")
  verified    Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("institution_profiles")
}

model Product {
  id           String      @id @default(uuid())
  title        String
  volumeNumber Int         @map("volume_number") // 1, 2, 3, or 0 for bundle
  price        Float
  stock        Int         @default(0)
  isbn         String      @unique
  description  String
  images       String[]
  hsnCode      String      @default("4901") @map("hsn_code")
  gstRate      Float       @default(0.0) @map("gst_rate")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  orderItems   OrderItem[]
  cartItems    CartItem[]

  @@map("products")
}

model DiscountTier {
  id              String   @id @default(uuid())
  minQuantity     Int      @map("min_quantity")
  maxQuantity     Int?     @map("max_quantity")
  discountPercent Float    @map("discount_percent")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("discount_tiers")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  orderType       OrderType     @default(INDIVIDUAL) @map("order_type")
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod @default(RAZORPAY) @map("payment_method")
  subtotal        Float
  discountApplied Float         @default(0.0) @map("discount_applied")
  total           Float
  gstAmount       Float         @default(0.0) @map("gst_amount")
  tdsExpected     Float         @default(0.0) @map("tds_expected")
  tdsReceived     Float         @default(0.0) @map("tds_received")
  shippingAddress String?       @map("shipping_address")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  invoices        Invoice[]
  poUploads       POUpload[]
  payments        Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int
  unitPrice Float    @map("unit_price")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Invoice {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  type      InvoiceType @default(FINAL)
  pdfUrl    String?     @map("pdf_url")
  gstAmount Float       @default(0.0) @map("gst_amount")
  irn       String?
  qrCode    String?     @map("qr_code")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("invoices")
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  email       String
  phone       String
  collegeName String     @map("college_name")
  source      LeadSource @default(FORM)
  status      LeadStatus @default(CONTACTED)
  notes       String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@map("leads")
}

model POUpload {
  id         String         @id @default(uuid())
  orderId    String         @map("order_id")
  fileUrl    String         @map("file_url")
  status     POUploadStatus @default(PENDING_REVIEW)
  uploadedAt DateTime       @default(now()) @map("uploaded_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("po_uploads")
}

model Payment {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  gatewayPaymentId  String?  @map("gateway_payment_id")
  gatewayOrderId    String?  @map("gateway_order_id")
  amount            Float
  status            String
  rawWebhookPayload Json?    @map("raw_webhook_payload")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([gatewayPaymentId])
  @@index([orderId])
  @@map("payments")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}
